<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sound_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="24dp"
    android:paddingBottom="14dp">

    <!-- Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/sound_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sound_back"
            android:contentDescription="@string/back"
            android:padding="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <HorizontalScrollView
                android:id="@+id/presets_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/presets_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:id="@+id/presets_fade_left"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/fade_left"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/presets_scroll_left"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/sound_scroll_left"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/text"
                android:visibility="gone" />

            <View
                android:id="@+id/presets_fade_right"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/fade_right" />

            <ImageButton
                android:id="@+id/presets_scroll_right"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/sound_scroll_right"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text" />
        </FrameLayout>
    </LinearLayout>

    <!-- Curve and cabin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_sound_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"
                    android:text="@string/sound_character"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sound_headroom"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_mode32"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/sound_mode32"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="@color/switch_track" />
            </LinearLayout>

            <com.agung.headhome.EqCurveView
                android:id="@+id/sound_curve"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/sound_knobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/sound_adv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adv_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/sound_band_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="@string/sound_prev_band"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="@color/text" />

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sound_selected_band"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/sound_band_hz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/sound_band_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="@string/sound_next_band"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/sound_band_down"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="@string/sound_band_down"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/text" />

                <TextView
                    android:id="@+id/sound_band_db"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/sound_band_up"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="@string/sound_band_up"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/text" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_hint_all"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/sound_all_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/sound_all_down"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_accent"
                        android:contentDescription="@string/sound_all_down"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_minus"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/sound_all_up"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_accent"
                        android:contentDescription="@string/sound_all_up"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sound_flatten"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_flat_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/sound_flatten"
                    android:textColor="#C4C8CE"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_sound_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="@string/sound_position"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.agung.headhome.CabinView
                android:id="@+id/sound_cabin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/sound_seat_row1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/sound_seat_row2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sound_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Switch
                android:id="@+id/sound_limiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_limiter"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:thumbTint="#FFFFFF"
                android:trackTint="@color/switch_track" />

            <TextView
                android:id="@+id/sound_limiter_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="250dp"
                android:text="@string/sound_limiter_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:orientation="vertical">

            <Switch
                android:id="@+id/sound_smart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_smart"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:thumbTint="#FFFFFF"
                android:trackTint="@color/switch_track" />

            <TextView
                android:id="@+id/sound_smart_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="250dp"
                android:text="@string/sound_smart_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/sound_presets_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_flat_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/sound_presets_button"
            android:textColor="#C4C8CE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sound_ab"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_ab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sound_factory"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sound_factory_dsp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
