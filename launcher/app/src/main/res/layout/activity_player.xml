<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/player_root"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/header_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/header_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/search_box"
            android:layout_width="420dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:tint="@color/muted" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                android:importantForAutofill="no"
                android:inputType="textFilter|textNoSuggestions"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/search_hide_keyboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/hide_keyboard"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_hide"
                android:tint="@color/text"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_marginStart="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/search_clear"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="@color/text"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Folders -->
            <FrameLayout
                android:id="@+id/folders_card"
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel">

                <ListView
                    android:id="@+id/folder_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:fadeScrollbars="false"
                    android:fastScrollAlwaysVisible="true"
                    android:fastScrollEnabled="true"
                    android:clipToPadding="false"
                    android:scrollbarSize="6dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbarThumbVertical="@drawable/scroll_thumb"
                    android:scrollbarTrackVertical="@drawable/scroll_track"
                    android:scrollbars="vertical" />
            </FrameLayout>

            <!-- Songs or search results -->
            <LinearLayout
                android:id="@+id/songs_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/songs_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.15"
                    android:maxLines="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_border" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/song_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@null"
                        android:fadeScrollbars="false"
                        android:fastScrollAlwaysVisible="true"
                        android:fastScrollEnabled="true"
                        android:clipToPadding="false"
                    android:scrollbarSize="6dp"
                    android:scrollbarStyle="outsideOverlay"
                        android:scrollbarThumbVertical="@drawable/scroll_thumb"
                        android:scrollbarTrackVertical="@drawable/scroll_track"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/songs_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:text="@string/no_matches"
                        android:textColor="@color/muted"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Vinyl -->
            <LinearLayout
                android:id="@+id/vinyl_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vinyl_card"
                android:clipChildren="false"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.agung.headhome.VinylView
                        android:id="@+id/vinyl"
                        android:layout_width="250dp"
                        android:layout_height="250dp" />

                    <ImageView
                        android:id="@+id/tonearm"
                        android:layout_width="120dp"
                        android:layout_height="170dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-14dp"
                        android:layout_marginEnd="-44dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tonearm" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/vinyl_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/vinyl_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#A3A8B0"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/np_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/np_elapsed"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/np_seek"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressDrawable="@drawable/progress_seek"
                    android:splitTrack="false"
                    android:thumb="@android:color/transparent"
                    android:thumbOffset="0dp" />

                <TextView
                    android:id="@+id/np_duration"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/np_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/np_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/np_shuffle"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/shuffle"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shuffle"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/np_prev"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/prev"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/np_play"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_round_light"
                        android:contentDescription="@string/play"
                        android:padding="19dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:tint="@color/dark_icon" />

                    <ImageButton
                        android:id="@+id/np_next"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/next"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        android:tint="@color/text" />

                    <ImageButton
                        android:id="@+id/np_repeat"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/repeat_all"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/text" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/np_volume_zone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/np_vol_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/volume_down"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_minus"
                        android:tint="@color/text" />

                    <ProgressBar
                        android:id="@+id/np_vol_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="150dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/volume"
                        android:max="40"
                        android:progressDrawable="@drawable/progress_seek" />

                    <TextView
                        android:id="@+id/np_vol_value"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#C4C8CE"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/np_vol_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_round"
                        android:contentDescription="@string/volume_up"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
