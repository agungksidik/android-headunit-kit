<?xml version="1.0" encoding="utf-8"?>
                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:id="@+id/music_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/music_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/music_art"
                            android:layout_width="@dimen/music_art_size"
                            android:layout_height="@dimen/music_art_size"
                            android:background="@drawable/bg_art"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/music_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/music_artist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/music_album"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ProgressBar
                        android:id="@+id/music_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_music" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/music_elapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/music_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageButton
                                android:id="@+id/music_shuffle"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_round"
                                android:contentDescription="@string/shuffle"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_shuffle"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageButton
                                android:id="@+id/music_prev"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_round"
                                android:contentDescription="@string/prev"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_prev"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageButton
                                android:id="@+id/music_play"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_round_light"
                                android:contentDescription="@string/play"
                                android:padding="16dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                android:tint="@color/dark_icon" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageButton
                                android:id="@+id/music_next"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_round"
                                android:contentDescription="@string/next"
                                android:padding="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_next"
                                android:tint="@color/text" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageButton
                                android:id="@+id/music_repeat"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_round"
                                android:contentDescription="@string/repeat_all"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_repeat"
                                android:tint="@color/text" />
                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/vol_minus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_round"
                            android:contentDescription="@string/volume_down"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_minus"
                            android:tint="@color/text" />

                        <ProgressBar
                            android:id="@+id/vol_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/volume"
                            android:max="40"
                            android:progressDrawable="@drawable/progress_music" />

                        <TextView
                            android:id="@+id/vol_value"
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <ImageButton
                            android:id="@+id/vol_plus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_round"
                            android:contentDescription="@string/volume_up"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/text" />
                    </LinearLayout>
                </LinearLayout>
